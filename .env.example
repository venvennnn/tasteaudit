# Server-only secrets. Do not add a NEXT_PUBLIC_ prefix.
# Placeholders only. Copy this file to .env.local and fill the values there.

# The hackathon key works only against this host. Do not use https://api.qloo.com.
# When QLOO_BASE_URL is unset, the server uses the hackathon host.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

GEMINI_API_KEY=
# Documented structured-output model. When GEMINI_MODEL is unset, the server uses this id.
# Gemini 3.8 does not accept temperature or top-p, so those parameters are not sent.
GEMINI_MODEL=gemini-3.8-flash

# Optional. When set, scoring returns a short-lived HMAC envelope and repair
# accepts numeric affinity only when the envelope verifies. When unset, repair
# still chooses from the allowlist but does not treat scores as provider-authenticated.
EVIDENCE_SIGNING_SECRET=

# Optional limits. These are per-invocation or per-isolate controls, not a durable global rate limiter.
TASTEAUDIT_MAX_CITIES=3
TASTEAUDIT_INSTANCE_RPM=40
QLOO_TIMEOUT_MS=12000
GEMINI_TIMEOUT_MS=25000
